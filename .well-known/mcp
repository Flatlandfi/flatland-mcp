{
  "schema_version": "v1",
  "name": "flatland",
  "display_name": "flatland",
  "description": "Connect an MCP-compatible agent to flatland's financial modeling engine.",
  "homepage": "https://flatlandfi.com",
  "documentation": "https://flatlandfi.com/install",
  "license": "MIT",
  "categories": [
    "finance",
    "financial-modeling",
    "analytics",
    "productivity"
  ],
  "server": {
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "flatland-client", "mcp"],
    "env": {
      "FLATLAND_API_KEY": {
        "required": true,
        "description": "Existing flatland API key; see https://flatlandfi.com/install for access and setup."
      }
    }
  },
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  }
}
