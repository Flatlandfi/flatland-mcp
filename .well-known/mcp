{
  "schema_version": "v1",
  "name": "flatland",
  "display_name": "flatland (legacy hosted connection)",
  "description": "Legacy hosted modeling connection for existing flatland API-key holders. For Desk's local connection, use its Your own agent setup.",
  "homepage": "https://flatlandfi.com",
  "documentation": "https://github.com/Flatlandfi/flatland-mcp#existing-api-key-holders",
  "license": "MIT",
  "categories": [
    "finance",
    "financial-modeling",
    "analytics",
    "productivity"
  ],
  "server": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "flatland-client",
      "mcp"
    ],
    "env": {
      "FLATLAND_API_KEY": {
        "required": true,
        "description": "Existing flatland API key for the legacy hosted connection. Desk's local connection does not use this key."
      }
    }
  },
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  }
}
